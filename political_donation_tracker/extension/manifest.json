{
  "manifest_version": 3,
  "name": "Political Donation Tracker",
  "version": "0.1.0",
  "description": "Track politician fundraising, donor types, and LLM financial summaries from FEC data.",
  "action": {
    "default_title": "Political Donation Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://upload.wikimedia.org/*",
    "https://*.wikipedia.org/*"
  ]
}
